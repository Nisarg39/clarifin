{
  "expo": {
    "name": "Clarifin",
    "slug": "clarifin",
    "version": "1.0.4",
    "scheme": "clarifin",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EBF4FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clarifin.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030334"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.clarifin.app",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86cb53df-dda2-438f-a566-53ead140ef1d"
      }
    },
    "owner": "nisarg39"
  }
}
